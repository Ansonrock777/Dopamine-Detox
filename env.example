# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Supabase Database Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# NextDNS Provider (managed by backend)
NEXTDNS_PROVIDER_API_KEY=your_nextdns_business_api_key_here
NEXTDNS_PROVIDER_ACCOUNT_ID=your_nextdns_account_id_here

# Polar (billing)
POLAR_WEBHOOK_SECRET=whsec_your_polar_webhook_secret_here

# App URL (public, where Polar sends webhooks)
# For local dev behind a tunnel, set to your tunnel URL
# Example: https://your-ngrok-or-cloudflare-tunnel-url
APP_URL=http://localhost:3000